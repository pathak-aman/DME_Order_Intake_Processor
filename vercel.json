{
  "rewrites": [
    {
      "source": "/(auth|orders|health|docs|redoc|openapi.json)(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    }
  ]
}
