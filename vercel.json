{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(auth|orders|health|docs|redoc|openapi\\.json)(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/dashboard.html",
      "dest": "/frontend/dme_order_intake_dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}